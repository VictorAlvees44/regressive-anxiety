rules_version = '2';

// Firestore Security Rules — Regressive Anxiety
//
// Princípios:
// 1. Apenas UIDs cadastrados na coleção administrativa podem acessar
//    os dados compartilhados.
// 2. Os dados compartilhados do casal (eventos, lista de desejos) são
//    privados: visitantes não podem ler nem escrever.
// 3. Usuários não autenticados não têm acesso a nada no Firestore
//    (os dados públicos de sugestões de lançamentos vêm dos arquivos
//    JSON estáticos, não do Firestore).
// 4. Toda validação de permissão acontece aqui — o frontend nunca é
//    a fonte de verdade da autorização.
// 5. A biblioteca é privada por UID: cada pessoa acessa somente a própria.
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function ehAdministrador() {
      return estaAutenticado() &&
        exists(/databases/$(database)/documents/administradores/$(request.auth.uid));
    }

    // Os documentos de administradores são criados pelo proprietário no
    // Console/Admin SDK. O app cliente nunca pode listar ou alterá-los.
    match /administradores/{uid} {
      allow read, write: if false;
    }

    // Eventos: dados COMPARTILHADOS entre os dois administradores
    // (é o painel de um casal, não dados isolados por conta).
    // Visitantes não podem visualizar nem escrever.
    match /eventos/{eventoId} {
      allow read, write: if ehAdministrador();
    }

    // Lista de desejos: mesma lógica de compartilhamento dos eventos.
    match /listaDesejos/{itemId} {
      allow read, write: if ehAdministrador();
    }

    // Biblioteca pessoal: nunca mistura os dados privados com a agenda compartilhada.
    match /bibliotecas/{uid}/itens/{itemId} {
      allow read, delete: if estaAutenticado() && request.auth.uid == uid;
      allow create, update: if estaAutenticado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['sugestao', 'status', 'nota', 'criadoEm', 'atualizadoEm'])
        && request.resource.data.status in ['quero', 'em-andamento', 'finalizado']
        && (request.resource.data.nota == null || (request.resource.data.nota is int && request.resource.data.nota >= 1 && request.resource.data.nota <= 5))
        && request.resource.data.sugestao is map
        && request.resource.data.sugestao.idExterno is string
        && request.resource.data.sugestao.titulo is string
        && request.resource.data.sugestao.categoria in ['filmes', 'series', 'jogos']
        && request.resource.data.criadoEm is string
        && request.resource.data.atualizadoEm is string;
    }

    // Logs administrativos: apenas administradores podem ler ou escrever.
    // Nunca expostos a visitantes.
    match /logs/{logId} {
      allow read: if ehAdministrador();
      allow write: if ehAdministrador();
    }

    // Backups: apenas administradores.
    match /backups/{backupId} {
      allow read: if ehAdministrador();
      allow write: if ehAdministrador();
    }

    // Documento "sonda": não guarda nenhum dado real, existe só para o
    // cliente perguntar "eu sou administrador?" sem receber a lista de UIDs.
    // O SDK tenta ler e a regra abaixo responde apenas sim/não.
    match /sistema/statusAdmin {
      allow read: if ehAdministrador();
      allow write: if false;
    }

    // Qualquer outra coleção não prevista explicitamente é negada por
    // padrão (nenhuma regra de "allow" corresponde a ela).
  }
}
